# === Biržas piekļuve (Binance) ===
# Paņem no https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# === Drošības režīms ===
# true = tikai simulācija (nekādas reālas orderu izpildes)
# false = reāla tirdzniecība (UZMANĪGI!)
DRY_RUN=true

# Ja true, izmanto Binance Testnet (drošs eksperimentiem)
USE_TESTNET=true

# === Tirdzniecības parametri ===
# Altcoin pāri, kurus tirgot (atdalīti ar komatu)
TRADING_PAIRS=SOL/USDT,AVAX/USDT,MATIC/USDT,DOT/USDT,LINK/USDT

# Sveces intervāls: 1m, 5m, 15m, 1h, 4h, 1d
TIMEFRAME=15m

# Cik USDT ieguldīt vienā darījumā
TRADE_AMOUNT_USDT=50

# Maksimāli vienlaicīgi atvērtas pozīcijas
MAX_OPEN_POSITIONS=3

# === Risku pārvaldība ===
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=5.0

# Minimālais take-profit slieksnis. Bots NEATVĒRS pozīciju, ja pēdējo
# LOOKBACK_CANDLES sveču maksimālā cena nav vismaz par tik % augstāka par
# ieejas cenu (t.i. TP nav reāli sasniedzams tuvākajā laikā).
MIN_TAKE_PROFIT_PERCENT=5.0
LOOKBACK_CANDLES=20

# === Stratēģijas parametri ===
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERSOLD=35
RSI_OVERBOUGHT=70

# === Cikla intervāls sekundēs ===
LOOP_INTERVAL_SEC=60
