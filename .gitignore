# ---------------------------------------------------------------------------
# Unreal Engine 5 - generated/derived files. Never commit these; they are
# rebuilt locally by the engine/UBT on first open or build and are large,
# binary, and machine-specific.
# ---------------------------------------------------------------------------

# Compiled binaries and intermediate build artifacts
Binaries/
Intermediate/
DerivedDataCache/
Build/
Saved/

# Per-platform / per-module intermediate folders that can appear anywhere
**/Binaries/
**/Intermediate/
**/DerivedDataCache/

# Editor-generated project files (regenerated by "Generate Visual Studio project files")
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb
*.xcodeproj
*.xcworkspace
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider / JetBrains
.idea/

# macOS
.DS_Store

# Crash reports / logs
*.log
CrashReportClient/

# Precompiled plugin binaries (if any third-party plugins are added under Plugins/)
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Packaged builds
Saved/StagedBuilds/
Saved/Cooked/

# Content hot-reload / autosave clutter
Content/Collections/
Saved/Autosaves/

# Local, machine-specific config overrides (never shared between contributors)
Config/DefaultEditorPerProjectUserSettings.ini
Config/UserEngine.ini

# Source control / packaging metadata UE writes locally
*.opt
*.tmp
