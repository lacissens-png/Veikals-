# ---------------------------------------------------------------------------
# Datubāze
# ---------------------------------------------------------------------------
# Lokāli ar Docker: docker compose up -d db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abonementi?schema=public

# ---------------------------------------------------------------------------
# Enable Banking (PSD2 / Open Banking)
# ---------------------------------------------------------------------------
ENABLE_BANKING_API_URL=https://api.enablebanking.com
ENABLE_BANKING_CLIENT_ID=
ENABLE_BANKING_CLIENT_SECRET=
# Uz šo URL banka atgriež lietotāju pēc autorizācijas.
# Vietējā izstrādē: http://localhost:4000/api/bank/callback
ENABLE_BANKING_REDIRECT_URI=http://localhost:4000/api/bank/callback
# Kad true, bankas API netiek izsaukts — tiek izmantoti testa darījumi no
# src/services/bank/fixtures.ts. Ļauj izmēģināt visu plūsmu bez PSD2 līguma.
ENABLE_BANKING_MOCK=true

# ---------------------------------------------------------------------------
# Claude API (darījumu kategorizēšana + atcelšanas melnraksti)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Neobligāti — noklusējums ir claude-opus-5
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Aplikācija
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Vismaz 32 rakstzīmes. Ģenerē ar: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-32
# Bankas piekļuves tokenu šifrēšanai datubāzē (AES-256-GCM).
# 64 hex rakstzīmes. Ģenerē ar: openssl rand -hex 32
# Obligāts, kad ENABLE_BANKING_MOCK=false. Mock režīmā tokena nav, tāpēc nav vajadzīgs.
TOKEN_ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d
# Komatiem atdalīts saraksts; * atļauj visus (tikai izstrādei)
CORS_ORIGIN=*
# Cik mēnešus atpakaļ ielādēt darījumus
TRANSACTION_SYNC_MONTHS=3
# Uz šejieni lietotājs tiek novirzīts pēc bankas OAuth (Expo deep link)
APP_REDIRECT_URL=abonementi://bank-callback
